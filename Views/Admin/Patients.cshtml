@model List<ClinicManagementSystem.ViewModels.AdminPatientDetailsViewModel>

@{
    ViewData["Title"] = "All Patients";
}

<div class="container py-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3">← Back to Dashboard</a>

    <h2 class="fw-bold mb-4">All Registered Patients</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Patient Code</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Registered On</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var patient in Model)
                            {
                                <tr>
                                    <td>@patient.PatientCode</td>
                                    <td>@patient.FullName</td>
                                    <td>@patient.Email</td>
                                    <td>@patient.Phone</td>
                                    <td>@patient.Age</td>
                                    <td>@patient.Gender</td>
                                    <td>@patient.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <a asp-action="PatientDetails" asp-route-patientId="@patient.Id" class="btn btn-sm btn-outline-primary">View Details</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">No patients registered yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>