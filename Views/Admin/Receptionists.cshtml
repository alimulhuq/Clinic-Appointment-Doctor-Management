@model List<ClinicManagementSystem.ViewModels.ReceptionistManagementViewModel>

@{
    ViewData["Title"] = "Manage Receptionists";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Manage Receptionists</h3>
        <a asp-action="AddReceptionist" class="btn btn-success">+ Add Receptionist</a>
    </div>

    <div class="card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.FullName</td>
                        <td>@r.Email</td>
                        <td>@r.Phone</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>