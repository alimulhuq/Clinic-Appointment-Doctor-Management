@model List<ClinicManagementSystem.ViewModels.DoctorManagementViewModel>

@{
    ViewData["Title"] = "Manage Doctors";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Manage Doctors</h3>
        <a asp-action="AddDoctor" class="btn btn-success">+ Add Doctor</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Specialization</th>
                        <th>Qualification</th>
                        <th>Experience</th>
                        <th>Fee</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var d in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="doctor-row-avatar">
                                            @if (!string.IsNullOrEmpty(d.ProfilePicture))
                                            {
                                                <img src="@d.ProfilePicture" alt="@d.FullName" />
                                            }
                                            else
                                            {
                                                <img src="/img/default-doctor.png" alt="@d.FullName" />
                                            }
                                        </div>
                                        <span>@d.FullName</span>
                                    </div>
                                </td>
                                <td>@d.Email</td>
                                <td>@d.Phone</td>
                                <td>@d.Specialization</td>
                                <td>@d.Qualification</td>
                                <td>@d.Experience yrs</td>
                                <td>@d.ConsultationFee.ToString("0.00")৳</td>
                                <td>
                                    <a asp-action="DoctorDetails" asp-route-id="@d.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-action="EditDoctor" asp-route-id="@d.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="DeleteDoctor" asp-route-id="@d.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No doctors added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<style>
    .doctor-row-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        overflow: hidden; border: 2px solid #e5e7eb;
        background: #eef2ff; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .doctor-row-avatar img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
</style>