@model ClinicManagementSystem.ViewModels.ReceptionistManagementViewModel

@{
    ViewData["Title"] = "Delete Receptionist";
}

<div class="container py-4">
    <a asp-action="Receptionists" class="btn btn-outline-secondary btn-sm mb-3">← Back to Receptionists</a>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Receptionist</h4>
        </div>
        <div class="card-body p-4">

            <div class="alert alert-warning">
                Are you sure you want to permanently delete this receptionist?
                This action cannot be undone.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>
            </dl>

            <form asp-action="DeleteReceptionist" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Yes, Delete
                </button>
                <a asp-action="Receptionists" class="btn btn-outline-secondary">Cancel</a>
            </form>

        </div>
    </div>
</div>