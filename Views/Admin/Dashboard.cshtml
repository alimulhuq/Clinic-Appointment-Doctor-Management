@model ClinicManagementSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var selected = Model.SelectedRange ?? "week";
}

<div class="portal-page">
    <!-- Top header bar -->
    <div class="portal-topbar d-flex justify-content-between align-items-start flex-wrap gap-3 mb-2">
        <div>
            <div class="portal-breadcrumb">CLINICAL PORTAL</div>
            <div class="portal-subbreadcrumb">SYSTEM ADMIN / CLINICCARE</div>
            <h1 class="portal-title mb-0">Clinic Operations &amp; Management</h1>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">

            <div class="portal-period-tabs" role="tablist" aria-label="Dashboard time range">
                <a asp-action="Dashboard" asp-route-range="today"
                   class="period-tab @(selected == "today" ? "active" : "")"
                   role="tab" aria-selected="@(selected == "today")">
                    <i class="bi bi-sun"></i>
                    <span>Today</span>
                </a>
                <a asp-action="Dashboard" asp-route-range="week"
                   class="period-tab @(selected == "week" ? "active" : "")"
                   role="tab" aria-selected="@(selected == "week")">
                    <i class="bi bi-calendar-week"></i>
                    <span>Last 7 Days</span>
                </a>
                <a asp-action="Dashboard" asp-route-range="month"
                   class="period-tab @(selected == "month" ? "active" : "")"
                   role="tab" aria-selected="@(selected == "month")">
                    <i class="bi bi-calendar-month"></i>
                    <span>This Month</span>
                </a>
            </div>

            <a asp-action="AddReceptionist" class="btn btn-portal-outline">
                <i class="bi bi-building me-1"></i> Add Receptionist
            </a>
            <a asp-action="AddDoctor" class="btn btn-portal-primary">
                <i class="bi bi-person-plus me-1"></i> Add New Doctor
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null){
        <div class="alert alert-success border-0 shadow-sm mb-3">@TempData["SuccessMessage"]</div>
    }

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="portal-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="portal-stat-label">Total Staff Doctors</span>
                    <span class="portal-stat-icon"><i class="bi bi-heart-pulse"></i></span>
                </div>
                <div class="portal-stat-value">@Model.TotalDoctors</div>
                <div class="portal-stat-meta text-success">
                    <i class="bi bi-graph-up-arrow"></i> Active staff
                </div>
                <div class="portal-stat-bar">
                    <div class="portal-stat-bar-fill" style="width: 75%"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="portal-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="portal-stat-label">Registered Patients</span>
                    <span class="portal-stat-icon"><i class="bi bi-people"></i></span>
                </div>
                <div class="portal-stat-value">@Model.TotalPatients.ToString("N0")</div>
                <div class="portal-stat-meta text-success">
                    <i class="bi bi-arrow-up"></i> In system
                </div>
                <div class="portal-stat-bar">
                    <div class="portal-stat-bar-fill" style="width: 88%"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="portal-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="portal-stat-label">Total Appointments</span>
                    <span class="portal-stat-icon"><i class="bi bi-calendar2-check"></i></span>
                </div>
                <div class="portal-stat-value">@Model.TotalAppointments</div>
                <div class="portal-stat-meta text-muted">
                    All bookings
                </div>
                <div class="portal-stat-bar">
                    <div class="portal-stat-bar-fill" style="width: 62%"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="portal-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="portal-stat-label">Receptionists</span>
                    <span class="portal-stat-icon"><i class="bi bi-person-badge"></i></span>
                </div>
                <div class="portal-stat-value">@Model.TotalReceptionists</div>
                <div class="portal-stat-meta text-primary">
                    <span class="dot-active"></span> Staff on duty
                </div>
                <div class="portal-stat-bar">
                    <div class="portal-stat-bar-fill" style="width: 100%"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="portal-stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="portal-stat-label">Cancelled Appointments</span>
                    <span class="portal-stat-icon"><i class="bi bi-x-octagon"></i></span>
                </div>
                <div class="portal-stat-value text-danger">@Model.RangeCancelled</div>
                <div class="portal-stat-meta text-muted">
                    Selected period
                </div>
                <div class="portal-stat-bar">
                    <div class="portal-stat-bar-fill" style="width: 100%; background:#ef4444;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts row -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="portal-card h-100">
                <div class="portal-card-header">
                    <div>
                        <h5 class="mb-0 fw-semibold">@Model.ChartTitle</h5>
                        <p class="text-muted small mb-0">@Model.ChartSubtitle</p>
                    </div>
                    <div class="portal-legend">
                        <span><i class="legend-dot legend-completed"></i> Completed</span>
                        <span><i class="legend-dot legend-cancelled"></i> Cancelled/Rescheduled</span>
                    </div>
                </div>
                <div class="portal-card-body">
                    <div class="chart-box">
                        <canvas id="weeklyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="portal-card h-100">
                <div class="portal-card-header">
                    <div>
                        <h5 class="mb-0 fw-semibold">Appointment Status</h5>
                        <p class="text-muted small mb-0">
                            @if (selected == "today") { <text>Today's distribution</text> }
                            else if (selected == "month") { <text>This month's distribution</text> }
                            else { <text>Last 7 days distribution</text> }
                        </p>
                    </div>
                </div>
                <div class="portal-card-body text-center">
                    <div class="donut-wrap mx-auto">
                        <canvas id="statusChart"></canvas>
                        <div class="donut-center">
                            <div class="donut-number">@Model.RangeTotal</div>
                            <div class="donut-label">Total</div>
                        </div>
                    </div>
                    <ul class="portal-status-list list-unstyled mt-3 mb-0 text-start">
                        <li><span class="status-dot" style="background:#2563eb"></span> Confirmed <span class="ms-auto fw-medium">@Model.RangeConfirmed</span></li>
                        <li><span class="status-dot" style="background:#0ea5e9"></span> Pending <span class="ms-auto fw-medium">@Model.RangePending</span></li>
                        <li><span class="status-dot" style="background:#64748b"></span> Completed <span class="ms-auto fw-medium">@Model.RangeCompleted</span></li>
                        <li><span class="status-dot" style="background:#94a3b8"></span> Rejected / Other <span class="ms-auto fw-medium">@Model.RangeRejectedOther</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
    (function () {
        const chartLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels));
        const chartCompleted = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartCompleted));
        const chartCancelled = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartCancelled));

        const weeklyCtx = document.getElementById('weeklyChart');
        if (weeklyCtx) {
            new Chart(weeklyCtx, {
                type: 'bar',
                data: {
                    labels: chartLabels,
                    datasets: [
                        {
                            label: 'Completed',
                            data: chartCompleted,
                            backgroundColor: '#1e40af',
                            borderRadius: 4,
                            barPercentage: 0.55
                        },
                        {
                            label: 'Cancelled/Rescheduled',
                            data: chartCancelled,
                            backgroundColor: '#93c5fd',
                            borderRadius: 4,
                            barPercentage: 0.55
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { color: '#64748b', font: { size: 12 }, maxRotation: 0, autoSkip: true }
                        },
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#94a3b8',
                                font: { size: 11 },
                                stepSize: 1,
                                precision: 0
                            },
                            grid: { color: '#f1f5f9' }
                        }
                    }
                }
            });
        }

        const statusCtx = document.getElementById('statusChart');
        if (statusCtx) {
            const confirmed = @Model.RangeConfirmed;
            const pending = @Model.RangePending;
            const completed = @Model.RangeCompleted;
            const rejectedOther = @Model.RangeRejectedOther;
            const total = confirmed + pending + completed + rejectedOther;

            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Confirmed', 'Pending', 'Completed', 'Rejected/Other'],
                    datasets: [{
                        data: total > 0 ? [confirmed, pending, completed, rejectedOther] : [1, 0, 0, 0],
                        backgroundColor: ['#2563eb', '#0ea5e9', '#64748b', '#94a3b8'],
                        borderWidth: 0,
                        cutout: '72%'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: total > 0 }
                    }
                }
            });
        }
    })();
    </script>

    <style>
        .portal-period-tabs {
            display: inline-flex;
            align-items: center;
            padding: 4px;
            background: #f1f3f9;
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            gap: 2px;
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);
        }
        .period-tab {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 18px;
            font-size: 0.875rem;
            font-weight: 500;
            color: #64748b;
            text-decoration: none;
            border-radius: 999px;
            line-height: 1;
            white-space: nowrap;
            transition: color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
            cursor: pointer;
        }
        .period-tab i { font-size: 0.9rem; }
        .period-tab:hover:not(.active) {
            color: #1e293b;
            background: rgba(255, 255, 255, 0.7);
        }
        .period-tab:focus-visible {
            outline: 2px solid #4f46e5;
            outline-offset: 2px;
        }
        .period-tab.active {
            color: #ffffff;
            background: #4f46e5;
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.35);
            font-weight: 600;
        }
    </style>
}