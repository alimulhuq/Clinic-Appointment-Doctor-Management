@model ClinicManagementSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">Admin Dashboard</h2>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Doctors</h6>
                <h3 class="fw-bold">@Model.TotalDoctors</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Receptionists</h6>
                <h3 class="fw-bold">@Model.TotalReceptionists</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Patients</h6>
                <h3 class="fw-bold">@Model.TotalPatients</h3>
            </div>   
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Appointments</h6>
                <h3 class="fw-bold">@Model.TotalAppointments</h3>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white">Quick Actions</div>
        <div class="card-body d-flex gap-2">
            <a asp-controller="Admin" asp-action="Doctors" class="btn btn-outline-primary w-100">Manage Doctors</a>
            <a asp-controller="Admin" asp-action="Receptionists" class="btn btn-outline-primary w-100">Manage Receptionists</a>
            <a asp-controller="Admin" asp-action="Patients" class="btn btn-outline-primary w-100">Manage Patients</a>
        </div>
    </div>
    </div>