@model ClinicManagementSystem.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">Admin Dashboard</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Doctors</h6>
                <h3 class="fw-bold">@Model.TotalDoctors</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Receptionists</h6>
                <h3 class="fw-bold">@Model.TotalReceptionists</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Patients</h6>
                <h3 class="fw-bold">@Model.TotalPatients</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Appointments</h6>
                <h3 class="fw-bold">@Model.TotalAppointments</h3>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white">Quick Actions</div>
        <div class="card-body d-flex gap-2">
            <a asp-action="AddDoctor" class="btn btn-outline-primary w-100">Add Doctor</a>
            <a asp-action="AddReceptionist" class="btn btn-outline-primary w-100">Add Receptionist</a>
            <a asp-action="Patients" class="btn btn-outline-primary w-100">View Patients</a>
        </div>
    </div>

    <!-- All Patient Bookings -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0">
            <h5 class="fw-bold mb-0">All Patient Bookings</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AllAppointments.Any())
                        {
                            foreach (var appt in Model.AllAppointments)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="PatientDetails" asp-route-patientId="@appt.PatientId" class="text-decoration-none">
                                            @(appt.Patient?.FullName ?? "Unknown")
                                        </a>
                                    </td>
                                    <td>@(appt.Doctor?.Name ?? "Unknown")</td>
                                    <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                    <td>@appt.AppointmentTime.ToString(@"hh\:mm tt")</td>
                                    <td>@appt.Reason</td>
                                    <td>
                                        @if (appt.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (appt.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (appt.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                        }
                                        else if (appt.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@appt.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">No appointments yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>