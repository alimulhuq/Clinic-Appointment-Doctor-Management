@model ClinicManagementSystem.ViewModels.AdminAppointmentViewModel

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container py-4">
    <a asp-action="Appointments" class="btn btn-outline-secondary btn-sm mb-3">← Back to Appointments</a>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Appointment Details</h4>
            <span class="badge bg-light text-dark">@Model.Status</span>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Appointment Code</h6>
                    <p class="fw-bold">@Model.AppointmentCode</p>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Status</h6>
                    <p class="fw-bold">@Model.Status</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Patient</h6>
                    <p class="fw-bold">@Model.PatientName</p>
                    <p class="text-muted small mb-0">@Model.PatientCode &middot; @Model.PatientPhone</p>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Doctor</h6>
                    <p class="fw-bold">@Model.DoctorName</p>
                    <p class="text-muted small mb-0">@Model.DoctorSpecialization</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Appointment Date</h6>
                    <p>@Model.AppointmentDate.ToString("dd MMM yyyy")</p>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Appointment Time</h6>
                    <p>@DateTime.Today.Add(Model.AppointmentTime).ToString("hh:mm tt")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Duration</h6>
                    <p>@Model.DurationMinutes minutes</p>
                </div>
                <div class="col-md-6 mb-3">
                    <h6 class="text-muted">Booked On</h6>
                    <p>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
                </div>

                <div class="col-12 mb-3">
                    <h6 class="text-muted">Reason</h6>
                    <p>@(string.IsNullOrWhiteSpace(Model.Reason) ? "—" : Model.Reason)</p>
                </div>
            </div>
        </div>
    </div>
</div>