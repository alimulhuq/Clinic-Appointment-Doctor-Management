@model List<ClinicManagementSystem.ViewModels.AdminAppointmentViewModel>

@{
    ViewData["Title"] = "All Appointments";
    var current = ViewBag.StatusFilter as string ?? "";
}

<div class="container py-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3">← Back to Dashboard</a>

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="fw-bold mb-0">All Appointments</h2>

        <div class="portal-period-tabs" role="tablist" aria-label="Status filter">
            <a asp-action="Appointments"
               class="period-tab @(string.IsNullOrEmpty(current) ? "active" : "")">All</a>
            <a asp-action="Appointments" asp-route-status="Pending"
               class="period-tab @(current == "Pending" ? "active" : "")">Pending</a>
            <a asp-action="Appointments" asp-route-status="Confirmed"
               class="period-tab @(current == "Confirmed" ? "active" : "")">Confirmed</a>
            <a asp-action="Appointments" asp-route-status="Completed"
               class="period-tab @(current == "Completed" ? "active" : "")">Completed</a>
            <a asp-action="Appointments" asp-route-status="Cancelled"
               class="period-tab @(current == "Cancelled" ? "active" : "")">Cancelled</a>
            <a asp-action="Appointments" asp-route-status="Rejected"
               class="period-tab @(current == "Rejected" ? "active" : "")">Rejected</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var appt in Model)
                        {
                            var statusClass = appt.Status switch
                            {
                                "Completed" or "Confirmed" => "bg-success",
                                "Pending" => "bg-warning text-dark",
                                "Cancelled" or "Rejected" => "bg-danger",
                                "Rescheduled" => "bg-info text-dark",
                                _ => "bg-secondary"
                            };
                            <tr>
                                <td>@appt.AppointmentCode</td>
                                <td>
                                    @appt.PatientName
                                    <div class="text-muted small">@appt.PatientCode</div>
                                </td>
                                <td>
                                    @appt.DoctorName
                                    <div class="text-muted small">@appt.DoctorSpecialization</div>
                                </td>
                                <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                <td>@DateTime.Today.Add(appt.AppointmentTime).ToString("hh:mm tt")</td>
                                <td><span class="badge @statusClass">@appt.Status</span></td>
                                <td>
                                    <a asp-action="AppointmentDetails"
                                       asp-route-appointmentId="@appt.Id"
                                       class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No appointments found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* Reuses the professional period-tab styles from the dashboard */
    .portal-period-tabs {
        display: inline-flex;
        align-items: center;
        padding: 4px;
        background: #f1f3f9;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        gap: 2px;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);
        flex-wrap: wrap;
    }
    .period-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #64748b;
        text-decoration: none;
        border-radius: 999px;
        line-height: 1;
        white-space: nowrap;
        transition: color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
        cursor: pointer;
    }
    .period-tab:hover:not(.active) {
        color: #1e293b;
        background: rgba(255, 255, 255, 0.7);
    }
    .period-tab.active {
        color: #ffffff;
        background: #4f46e5;
        box-shadow: 0 2px 6px rgba(79, 70, 229, 0.35);
        font-weight: 600;
    }
</style>