@model ClinicManagementSystem.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="bg-primary text-white py-5">
    <div class="container py-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h1 class="fw-bold display-5">Your Health, Our Priority</h1>
                <p class="lead">Find the right doctor, check availability, and book your appointment easily.</p>
                <a asp-controller="Patient" asp-action="Doctors" class="btn btn-light text-primary btn-lg px-4 me-2">Find a Doctor</a>
                <a asp-controller="Patient" asp-action="Doctors" class="btn btn-outline-light btn-lg px-4">Book Appointment</a>
            </div>
            <div class="col-lg-6 text-center">
                <span style="font-size: 10rem;">🏥</span>
            </div>
        </div>
    </div>
</section>

<!-- QUICK APPOINTMENT SEARCH -->
<section class="container">
    <div class="card shadow-sm border-0" style="margin-top: -40px;">
        <div class="card-body p-4">
            <form class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Department</label>
                    <select class="form-select" name="department">
                        <option value="">All Departments</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Doctor</label>
                    <select class="form-select" name="doctor">
                        <option value="">Any Doctor</option>
                        @foreach (var doc in Model.AllDoctors)
                        {
                            <option value="@doc.Id">Dr. @doc.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date</label>
                    <input type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <button type="button" class="btn btn-primary w-100">Check Availability</button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- DEPARTMENTS -->
<section class="container py-5">
    <h2 class="fw-bold text-center mb-4">Medical Departments</h2>
    <div class="row g-4">
        @foreach (var dept in Model.Departments)
        {
            var doctorCount = Model.AllDoctors.Count(d => d.Specialization == dept);
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 text-center border-0 shadow-sm p-3">
                    <div style="font-size: 2rem;">🩺</div>
                    <h6 class="fw-bold mt-2">@dept</h6>
                    <p class="text-muted small">@doctorCount Doctor(s)</p>
                    <span class="badge bg-light text-dark">@doctorCount Doctors</span>
                </div>
            </div>
        }
    </div>
</section>

<!-- FEATURED DOCTORS -->
<section class="bg-light py-5">
    <div class="container">
        <h2 class="fw-bold text-center mb-4">Featured Doctors</h2>
        <div class="row g-4">
            @if (Model.FeaturedDoctors.Any())
            {
                @foreach (var doctor in Model.FeaturedDoctors)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="fw-bold mb-0">Dr. @doctor.Name</h5>
                                <p class="text-muted mb-1">@doctor.Specialization</p>
                                <p class="small mb-1">@doctor.Qualification &middot; @doctor.Experience years experience</p>
                                @if (doctor.Schedules.Any(s => s.IsActive))
                                {
                                    <span class="badge bg-success mb-2">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary mb-2">No Schedule</span>
                                }
                                <div class="d-flex gap-2 mt-2">
                                    <a asp-controller="Patient" asp-action="DoctorDetails" asp-route-id="@doctor.Id" class="btn btn-outline-primary btn-sm w-100">View Profile</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted text-center">No doctors available yet.</p>
            }
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="container py-5">
    <h2 class="fw-bold text-center mb-5">How It Works</h2>
    <div class="row text-center g-4">
        <div class="col-md-3">
            <div style="font-size: 2rem;">🔍</div>
            <h6 class="fw-bold mt-2">1. Find a Doctor</h6>
            <p class="text-muted small">Browse by specialization</p>
        </div>
        <div class="col-md-3">
            <div style="font-size: 2rem;">📅</div>
            <h6 class="fw-bold mt-2">2. Check Availability</h6>
            <p class="text-muted small">See open time slots</p>
        </div>
        <div class="col-md-3">
            <div style="font-size: 2rem;">📝</div>
            <h6 class="fw-bold mt-2">3. Book Appointment</h6>
            <p class="text-muted small">Confirm in seconds</p>
        </div>
        <div class="col-md-3">
            <div style="font-size: 2rem;">🤝</div>
            <h6 class="fw-bold mt-2">4. Meet Your Doctor</h6>
            <p class="text-muted small">Get the care you need</p>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="bg-primary text-white text-center py-5">
    <div class="container">
        <h2 class="fw-bold">Need to See a Doctor?</h2>
        <p class="lead">Book your appointment quickly and get the care you need.</p>
        <a asp-controller="Patient" asp-action="Doctors" class="btn btn-light text-primary btn-lg px-4">Book an Appointment</a>
    </div>
</section>