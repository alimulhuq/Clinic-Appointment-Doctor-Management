@model ClinicManagementSystem.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<!-- HERO -->
<section class="home-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="home-badge">ClinicCare · Trusted Care</span>
                <h1 class="home-hero-title">Your Health,<br />Our Priority</h1>
                <p class="home-hero-text">
                    Find the right specialist, check real-time availability, and book appointments
                    in minutes — all in one place.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Patient" asp-action="Doctors" class="btn home-btn-primary">
                        <i class="bi bi-search me-2"></i>Find a Doctor
                    </a>
                    <a asp-controller="Patient" asp-action="Doctors" class="btn home-btn-outline">
                        <i class="bi bi-calendar2-check me-2"></i>Book Appointment
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="home-hero-panel">
                    <div class="home-hero-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="home-stat-value">@Model.AllDoctors.Count</div>
                            <div class="home-stat-label">Doctors</div>
                        </div>
                        <div class="col-4">
                            <div class="home-stat-value">@Model.Departments.Count</div>
                            <div class="home-stat-label">Departments</div>
                        </div>
                        <div class="col-4">
                            <div class="home-stat-value">24/7</div>
                            <div class="home-stat-label">Support</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- QUICK SEARCH -->
<section class="container home-search-wrap">
    <div class="home-search-card">
        <div class="home-search-header">
            <h5 class="mb-0 fw-semibold">Quick Appointment Search</h5>
            <span class="text-muted small">Filter by department, doctor, or date</span>
        </div>
        <form class="row g-3 align-items-end" method="get" asp-controller="Patient" asp-action="Doctors">
            <div class="col-md-3">
                <label class="form-label home-label">Department</label>
                <select class="form-select home-input" name="department">
                    <option value="">All Departments</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept">@dept</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label home-label">Doctor</label>
                <select class="form-select home-input" name="doctor">
                    <option value="">Any Doctor</option>
                    @foreach (var doc in Model.AllDoctors)
                    {
                        <option value="@doc.Id">Dr. @doc.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label home-label">Preferred Date</label>
                <input type="text" class="form-control home-input home-date-input" name="date" id="preferredDate"
                       placeholder="Select a date" autocomplete="off"
                       data-min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn home-btn-primary w-100">
                    <i class="bi bi-calendar2-week me-1"></i> Check Availability
                </button>
            </div>
        </form>
    </div>
</section>

<!-- DEPARTMENTS -->
<section class="container py-5">
    <div class="text-center mb-4">
        <h2 class="home-section-title">Medical Departments</h2>
        <p class="text-muted mb-0">Specialized care across key clinical areas</p>
    </div>
    <div class="row g-3">
        @foreach (var dept in Model.Departments)
        {
            var doctorCount = Model.AllDoctors.Count(d => d.Specialization == dept);
            <div class="col-6 col-md-3">
                <div class="home-dept-card">
                    <div class="home-dept-icon"><i class="bi bi-heart-pulse"></i></div>
                    <h6 class="fw-semibold mb-1">@dept</h6>
                    <p class="text-muted small mb-2">@doctorCount specialist(s)</p>
                    <span class="home-chip">@doctorCount Doctors</span>
                </div>
            </div>
        }
    </div>
</section>

<!-- FEATURED DOCTORS -->
<section class="home-section-muted py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
            <div>
                <h2 class="home-section-title mb-1">Featured Doctors</h2>
                <p class="text-muted mb-0">Experienced clinicians ready to help</p>
            </div>
            <a asp-controller="Home" asp-action="Doctors" class="auth-link">View all doctors →</a>
        </div>
        <div class="row g-3">
            @if (Model.FeaturedDoctors.Any())
            {
                @foreach (var doctor in Model.FeaturedDoctors)
                {
                    <div class="col-md-4">
                        <div class="home-doctor-card">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="home-doctor-avatar">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div>
                                    <h5 class="fw-semibold mb-0">Dr. @doctor.Name</h5>
                                    <p class="text-muted small mb-0">@doctor.Specialization</p>
                                </div>
                            </div>
                            <p class="small text-muted mb-2">
                                @doctor.Qualification · @doctor.Experience yrs experience
                            </p>
                            @if (doctor.Schedules.Any(s => s.IsActive))
                            {
                                <span class="home-status-available">Available</span>
                            }
                            else
                            {
                                <span class="home-status-muted">No Schedule</span>
                            }
                            <a asp-controller="Patient" asp-action="DoctorDetails" asp-route-id="@doctor.Id"
                               class="btn home-btn-outline-sm w-100 mt-3">View Profile</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <p class="text-muted text-center mb-0">No doctors available yet.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="container py-5">
    <div class="text-center mb-4">
        <h2 class="home-section-title">How It Works</h2>
        <p class="text-muted mb-0">Four simple steps to quality care</p>
    </div>
    <div class="row g-3">
        <div class="col-md-3 col-6">
            <div class="home-step-card">
                <div class="home-step-num">1</div>
                <div class="home-step-icon"><i class="bi bi-search"></i></div>
                <h6 class="fw-semibold">Find a Doctor</h6>
                <p class="text-muted small mb-0">Browse by specialization</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="home-step-card">
                <div class="home-step-num">2</div>
                <div class="home-step-icon"><i class="bi bi-calendar3"></i></div>
                <h6 class="fw-semibold">Check Availability</h6>
                <p class="text-muted small mb-0">See open time slots</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="home-step-card">
                <div class="home-step-num">3</div>
                <div class="home-step-icon"><i class="bi bi-journal-check"></i></div>
                <h6 class="fw-semibold">Book Appointment</h6>
                <p class="text-muted small mb-0">Confirm in seconds</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="home-step-card">
                <div class="home-step-num">4</div>
                <div class="home-step-icon"><i class="bi bi-emoji-smile"></i></div>
                <h6 class="fw-semibold">Meet Your Doctor</h6>
                <p class="text-muted small mb-0">Get the care you need</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="home-cta">
    <div class="container text-center">
        <h2 class="home-cta-title">Need to See a Doctor?</h2>
        <p class="home-cta-text">Book your appointment quickly and get the care you need.</p>
        <a asp-controller="Patient" asp-action="Doctors" class="btn home-btn-light">
            Book an Appointment
        </a>
    </div>
</section>

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    var el = document.getElementById("preferredDate");
    if (!el || typeof flatpickr === "undefined") return;
    flatpickr(el, {
        dateFormat: "Y-m-d",
        minDate: el.getAttribute("data-min") || "today",
        disableMobile: true,
        monthSelectorType: "static"
    });
});
</script>
}