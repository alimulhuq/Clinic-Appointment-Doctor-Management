@model IEnumerable<Clinic_Application_Doctor_Management.Models.Prescription>

@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">My Prescriptions</h2>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Medicines</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="doctor-row-avatar">
                                        @if (!string.IsNullOrEmpty(p.Doctor?.ProfilePicture))
                                        {
                                            <img src="@p.Doctor.ProfilePicture" alt="@p.Doctor?.Name" />
                                        }
                                        else
                                        {
                                            <img src="/img/default-doctor.png" alt="@p.Doctor?.Name" />
                                        }
                                    </div>
                                    <span>@p.Doctor?.Name</span>
                                </div>
                            </td>
                            <td>@p.PrescriptionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <ul class="mb-0 ps-3">
                                    @foreach (var item in p.Items)
                                    {
                                        <li>@item.MedicineName - @item.Dosage (@item.Frequency) for @item.Duration</li>
                                    }
                                </ul>
                            </td>
                            <td>@p.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .doctor-row-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        overflow: hidden; border: 2px solid #e5e7eb;
        background: #eef2ff; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .doctor-row-avatar img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
</style>