@model ClinicManagementSystem.ViewModels.AppointmentViewModel

@{
    ViewData["Title"] = "Book Appointment";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Book Appointment</h2>
        <p class="text-muted">Select your preferred date and time.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">

                    <div class="bg-light rounded p-3 mb-4">
                        <div class="d-flex align-items-center">
                            <div class="fs-1 me-3">👨‍⚕️</div>
                            <div>
                                <h5 class="fw-bold mb-1">@Model.DoctorName</h5>
                                <span class="text-primary">@Model.Specialization</span>
                            </div>
                        </div>
                    </div>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="BookAppointment" asp-controller="Patient" method="post" id="bookingForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <input asp-for="DoctorId" type="hidden" />
                        <input asp-for="DoctorName" type="hidden" />
                        <input asp-for="Specialization" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold">Appointment Date</label>
                            <input asp-for="AppointmentDate" type="text" class="form-control datepicker-booking"
                                   id="appointmentDate" placeholder="Select appointment date" autocomplete="off" />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                            <div id="dateError" class="text-danger small mt-1" style="display:none;"></div>
                            <div class="form-text">Weekends are not available. Earliest booking is today.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AppointmentTime" class="form-label fw-semibold">Appointment Time</label>
                            <select asp-for="AppointmentTime" class="form-select" id="appointmentTime">
                                <option value="">Select a time</option>
                                <option value="10:00">10:00 AM</option>
                                <option value="10:30">10:30 AM</option>
                                <option value="11:00">11:00 AM</option>
                                <option value="11:30">11:30 AM</option>
                                <option value="16:00">04:00 PM</option>
                                <option value="16:30">04:30 PM</option>
                                <option value="17:00">05:00 PM</option>
                                <option value="17:30">05:30 PM</option>
                            </select>
                            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Reason" class="form-label fw-semibold">Reason for Visit</label>
                            <textarea asp-for="Reason" class="form-control" rows="4" placeholder="Briefly describe the reason for your visit"></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="Doctors" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary flex-grow-1">Continue to Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const dateInput = document.getElementById('appointmentDate');
            const timeSelect = document.getElementById('appointmentTime');
            const errorDiv = document.getElementById('dateError');
            const form = document.getElementById('bookingForm');

            function validateDateTime() {
                const raw = dateInput.value;   // Flatpickr stores "Y-m-d"
                if (!raw) { clearError(); return true; }

                const selectedDate = new Date(raw + 'T00:00:00');
                const now = new Date();

                // Weekend check
                const day = selectedDate.getDay();
                if (day === 0 || day === 6) {
                    showError('Appointments are not available on weekends.');
                    return false;
                }

                // Past date
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                if (selectedDate < today) {
                    showError('Please select a future date.');
                    return false;
                }

                // Today + time in the past
                if (selectedDate.getTime() === today.getTime() && timeSelect.value) {
                    const parts = timeSelect.value.split(':');
                    const h = parseInt(parts[0]);
                    const m = parseInt(parts[1]);
                    const selectedTime = new Date();
                    selectedTime.setHours(h, m, 0, 0);
                    if (selectedTime < now) {
                        showError('Please select a future time for today\'s appointment.');
                        return false;
                    }
                }

                clearError();
                return true;
            }

            function showError(message) {
                errorDiv.textContent = message;
                errorDiv.style.display = 'block';
                dateInput.classList.add('is-invalid');
            }
            function clearError() {
                errorDiv.textContent = '';
                errorDiv.style.display = 'none';
                dateInput.classList.remove('is-invalid');
            }

            dateInput.addEventListener('change', validateDateTime);
            timeSelect.addEventListener('change', validateDateTime);
            form.addEventListener('submit', function (e) {
                if (!validateDateTime()) e.preventDefault();
            });
        })();
    </script>
    <style>
        #appointmentDate.is-invalid { border-color: #dc3545; background-color: #f8d7da; }

        /* Make Flatpickr match Bootstrap inputs */
        .flatpickr-input[readonly] { background-color: #fff; cursor: pointer; }
        .flatpickr-calendar { border-radius: 10px; box-shadow: 0 6px 24px rgba(0,0,0,.08); }
    </style>
}