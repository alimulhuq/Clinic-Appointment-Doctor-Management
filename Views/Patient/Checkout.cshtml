@model ClinicManagementSystem.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Complete Your Payment</h4>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-info small">
                        Your appointment is saved as <strong>Pending</strong>.
                        Pay in full to confirm it, or pay partially and pay the rest later.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Doctor</dt>
                        <dd class="col-sm-8">@Model.DoctorName</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.AppointmentDate.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">@Model.AppointmentTime</dd>

                        <dt class="col-sm-4">Total Fee</dt>
                        <dd class="col-sm-8">@Model.TotalFee.ToString("0.00")৳</dd>

                        @if (Model.AlreadyPaid > 0)
                        {
                            <dt class="col-sm-4">Already Paid</dt>
                            <dd class="col-sm-8 text-success">@Model.AlreadyPaid.ToString("0.00")৳</dd>

                            <dt class="col-sm-4">Balance Due</dt>
                            <dd class="col-sm-8 fw-bold text-danger">@Model.BalanceDue.ToString("0.00")৳</dd>
                        }
                        else
                        {
                            <dt class="col-sm-4">Balance Due</dt>
                            <dd class="col-sm-8 fw-bold">@Model.BalanceDue.ToString("0.00")৳</dd>
                        }
                    </dl>

                    <form asp-action="Checkout" method="post">
                        <input type="hidden" asp-for="AppointmentId" />
                        <input type="hidden" asp-for="BillId" />

                        <div class="mb-3">
                            <label asp-for="AmountNow" class="form-label fw-semibold"></label>
                            <input asp-for="AmountNow" type="number" step="0.01" min="0" max="@Model.BalanceDue" class="form-control" />
                            <span asp-validation-for="AmountNow" class="text-danger small"></span>
                            <div class="form-text">
                                You can pay up to the balance due (@Model.BalanceDue.ToString("0.00")৳).
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="Cash">Cash</option>
                                <option value="Card">Card</option>
                                <option value="bKash">bKash</option>
                                <option value="Nagad">Nagad</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="MyAppointments" class="btn btn-outline-secondary">Pay Later</a>
                            <button type="submit" class="btn btn-primary flex-grow-1">Pay Now</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}