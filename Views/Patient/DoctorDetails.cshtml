@model ClinicManagementSystem.ViewModels.DoctorViewModel

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="display-1">
                            👨‍⚕️
                        </div>

                        <h2 class="fw-bold">
                            @Model.FullName
                        </h2>

                        <span class="badge bg-primary fs-6">
                            @Model.Specialization
                        </span>

                    </div>


                    <hr />


                    <div class="row g-4 mt-2">

                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Qualification
                            </h6>

                            <p class="fw-semibold">
                                @Model.Qualification
                            </p>

                        </div>


                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Experience
                            </h6>

                            <p class="fw-semibold">
                                @Model.Experience years
                            </p>

                        </div>


                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Phone
                            </h6>

                            <p class="fw-semibold">
                                @Model.Phone
                            </p>

                        </div>


                        <div class="col-md-6">

                            <h6 class="text-muted">
                                Available Days
                            </h6>

                            <p class="fw-semibold">
                                @Model.AvailableDays
                            </p>

                        </div>


                        <div class="col-12">

                            <h6 class="text-muted">
                                Available Time
                            </h6>

                            <p class="fw-semibold">
                                @Model.AvailableTime
                            </p>

                        </div>

                    </div>


                    <div class="d-flex gap-2 mt-4">

                        <a asp-controller="Patient"
                           asp-action="Doctors"
                           class="btn btn-outline-secondary">

                            ← Back

                        </a>

                        <a asp-controller="Patient"
                           asp-action="BookAppointment"
                           asp-route-id="@Model.DoctorId"
                           class="btn btn-primary flex-grow-1">

                            📅 Book Appointment

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>