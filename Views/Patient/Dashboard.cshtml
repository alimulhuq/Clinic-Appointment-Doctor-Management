@model ClinicManagementSystem.ViewModels.PatientDashboardViewModel

@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="container-fluid py-4">
    <!-- Welcome -->
    <div class="mb-4">
        <h2 class="fw-bold">Welcome, @(User.Identity?.Name ?? "Patient") 👋</h2>
        <p class="text-muted">Good to see you again!</p>
    </div>

    <!-- Statistics -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Upcoming Appointments</p>
                            <h3 class="fw-bold">@Model.UpcomingAppointments</h3>
                        </div>
                        <div class="fs-2">📅</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Completed Visits</p>
                            <h3 class="fw-bold">@Model.TotalVisits</h3>
                        </div>
                        <div class="fs-2">✅</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Pending Bills</p>
                            <h3 class="fw-bold">@Model.PendingBills</h3>
                        </div>
                        <div class="fs-2">💰</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Available Doctors</p>
                            <h3 class="fw-bold">@Model.AvailableDoctors</h3>
                        </div>
                        <div class="fs-2">🩺</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold">Quick Actions</h5>
                </div>
                <div class="card-body px-4">
                    <div class="d-grid gap-3">
                        <a asp-controller="Patient" asp-action="Doctors" class="btn btn-primary">Book Appointment</a>
                        <a asp-controller="Patient" asp-action="Doctors" class="btn btn-outline-primary">Find a Doctor</a>
                        <a asp-controller="Patient" asp-action="Profile" class="btn btn-outline-secondary">My Profile</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Appointments -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between">
                        <h5 class="fw-bold">Upcoming Appointments</h5>
                        <a asp-controller="Patient" asp-action="MyAppointments" class="text-decoration-none">View All</a>
                    </div>
                </div>
                <div class="card-body px-4">
                    @if (Model.RecentAppointments != null && Model.RecentAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Doctor</th>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appt in Model.RecentAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@appt.DoctorName</strong><br />
                                                <small class="text-muted">@appt.Specialization</small>
                                            </td>
                                            <td>@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                            <td>@appt.AppointmentTime</td>
                                            <td>
                                                @if (appt.Status == "Confirmed")
                                                {
                                                    <span class="badge bg-success">Confirmed</span>
                                                }
                                                else if (appt.Status == "Pending")
                                                {
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                }
                                                else if (appt.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger">Rejected</span>
                                                }
                                                else if (appt.Status == "Completed")
                                                {
                                                    <span class="badge bg-primary">Completed</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@appt.Status</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No upcoming appointments.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>