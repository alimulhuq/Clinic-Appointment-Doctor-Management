@model List<ClinicManagementSystem.ViewModels.DoctorViewModel>

@{
    ViewData["Title"] = "Find a Doctor";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Find a Doctor</h2>

        <p class="text-muted">
            Search and choose a doctor for your appointment.
        </p>
    </div>


    <!-- Search -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <input type="text"
                           class="form-control"
                           placeholder="Search doctor name..." />

                </div>

                <div class="col-md-4">

                    <select class="form-select">

                        <option>
                            All Specializations
                        </option>

                        <option>
                            Cardiologist
                        </option>

                        <option>
                            General Physician
                        </option>

                        <option>
                            Dermatologist
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- Doctors -->

    <div class="row g-4">

        @foreach (var doctor in Model)
        {
            <div class="col-md-6 col-lg-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="text-center mb-3">

                            <div class="display-5">
                                👨‍⚕️
                            </div>

                            <h5 class="fw-bold mt-2">
                                @doctor.FullName
                            </h5>

                            <span class="badge bg-primary">
                                @doctor.Specialization
                            </span>

                        </div>


                        <div class="text-muted small mb-3">

                            <p class="mb-2">
                                🎓 @doctor.Qualification
                            </p>

                            <p class="mb-2">
                                💼 @doctor.Experience years experience
                            </p>

                            <p class="mb-2">
                                📅 @doctor.AvailableDays
                            </p>

                            <p class="mb-2">
                                🕐 @doctor.AvailableTime
                            </p>

                        </div>


                        <div class="d-grid">

                            <a asp-controller="Patient"
                               asp-action="DoctorDetails"
                               asp-route-id="@doctor.DoctorId"
                               class="btn btn-outline-primary">

                                View Details

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>