@model List<ClinicManagementSystem.ViewModels.DoctorViewModel>

@{
    ViewData["Title"] = "Find a Doctor";
    var specializations = ViewBag.Specializations as List<string> ?? new List<string>();
    var currentSearch = ViewBag.Search as string ?? "";
    var currentSpec = ViewBag.SelectedSpecialization as string ?? "";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Find a Doctor</h2>
        <p class="text-muted">Search and choose a doctor for your appointment.</p>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Doctors" asp-controller="Patient">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="search" value="@currentSearch"
                               class="form-control" placeholder="Search doctor name..." />
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" name="specialization">
                            <option value="">All Specializations</option>
                            @foreach (var spec in specializations)
                            {
                                if (spec == currentSpec)
                                {
                                    <option value="@spec" selected>@spec</option>
                                }
                                else
                                {
                                    <option value="@spec">@spec</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Search</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var doctor in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="text-center mb-3">
                                <div class="doctor-card-avatar mx-auto mb-3">
                                    @if (!string.IsNullOrEmpty(doctor.ProfilePicture))
                                    {
                                        <img src="@doctor.ProfilePicture" alt="@doctor.FullName" />
                                    }
                                    else
                                    {
                                        <img src="/img/default-doctor.png" alt="@doctor.FullName" />
                                    }
                                </div>
                                <h5 class="fw-bold mt-2">@doctor.FullName</h5>
                                <span class="badge bg-primary">@doctor.Specialization</span>
                            </div>
                            <div class="text-muted small mb-3">
                                <p class="mb-2">🎓 @doctor.Qualification</p>
                                <p class="mb-2">💼 @doctor.Experience years experience</p>
                                <p class="mb-2">💰 Fee: @doctor.ConsultationFee.ToString("0.00")৳</p>
                                <p class="mb-2">📅 @(string.IsNullOrWhiteSpace(doctor.AvailableDays) ? "Not specified" : doctor.AvailableDays)</p>
                                <p class="mb-2">🕐 @doctor.AvailableTime</p>
                            </div>
                            <div class="d-grid">
                                <a asp-controller="Patient" asp-action="DoctorDetails" asp-route-id="@doctor.DoctorId"
                                   class="btn btn-outline-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">No doctors match your search criteria.</div>
    }
</div>

<style>
    .doctor-card-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        overflow: hidden;
        border: 3px solid #e5e7eb;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .doctor-card-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>