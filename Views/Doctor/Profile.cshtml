@model ClinicManagementSystem.ViewModels.DoctorProfileViewModel

@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">My Profile</h2>
        <p class="text-muted">View and update your professional information and weekly schedule.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Profile" asp-controller="Doctor" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Specialization" class="form-label"></label>
                                <input asp-for="Specialization" class="form-control" />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Qualification" class="form-label"></label>
                                <input asp-for="Qualification" class="form-control" />
                                <span asp-validation-for="Qualification" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Experience" class="form-label"></label>
                                <input asp-for="Experience" type="number" class="form-control" />
                                <span asp-validation-for="Experience" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationFee" class="form-label"></label>
                                <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="form-control" />
                                <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="About" class="form-label">About Doctor</label>
                                <textarea asp-for="About" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="About" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="text-muted mb-3">🗓️ Weekly Schedule</h6>
                        <p class="text-muted small">Tick the days you're available and set your hours.</p>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:80px;">Available</th>
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Schedule.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="Schedule[i].Day" />
                                                <input type="checkbox" class="form-check-input"
                                                       asp-for="Schedule[i].IsEnabled" id="sched_@i" />
                                            </td>
                                            <td>
                                                <label for="sched_@i" class="form-check-label fw-semibold">
                                                    @Model.Schedule[i].Day
                                                </label>
                                            </td>
                                            <td>
                                                <input type="time" class="form-control form-control-sm"
                                                       asp-for="Schedule[i].StartTime" />
                                            </td>
                                            <td>
                                                <input type="time" class="form-control form-control-sm"
                                                       asp-for="Schedule[i].EndTime" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 mt-3">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-4">
                    <div class="display-2 mb-3">👨‍⚕️</div>
                    <h5 class="fw-bold">@Model.FullName</h5>
                    <p class="text-primary mb-2">@Model.Specialization</p>
                    <p class="text-muted">@Model.Qualification</p>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}