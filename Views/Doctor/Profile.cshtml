@model ClinicManagementSystem.ViewModels.DoctorProfileViewModel

@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">My Profile</h2>
        <p class="text-muted">View and update your professional information and weekly schedule.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Profile" asp-controller="Doctor" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <!-- Profile picture -->
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="doctor-avatar-preview">
                                @if (!string.IsNullOrEmpty(Model.ExistingProfilePicture))
                                {
                                    <img id="avatarPreview" src="@Model.ExistingProfilePicture" alt="Profile picture" />
                                }
                                else
                                {
                                    <img id="avatarPreview" src="/img/default-doctor.png" alt="Default avatar" />
                                }
                            </div>
                            <div class="flex-grow-1">
                                <label asp-for="ProfilePictureFile" class="form-label fw-semibold"></label>
                                <input asp-for="ProfilePictureFile" type="file" accept="image/*"
                                       class="form-control" id="pictureInput" />
                                <div class="form-text">
                                    JPG, PNG, WEBP or GIF. Max 5 MB. Large images will be auto-resized.
                                </div>
                                <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label"></label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Specialization" class="form-label"></label>
                                <input asp-for="Specialization" class="form-control" />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Qualification" class="form-label"></label>
                                <input asp-for="Qualification" class="form-control" />
                                <span asp-validation-for="Qualification" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Experience" class="form-label"></label>
                                <input asp-for="Experience" type="number" class="form-control" />
                                <span asp-validation-for="Experience" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationFee" class="form-label"></label>
                                <input asp-for="ConsultationFee" type="number" step="0.01" min="0" class="form-control" />
                                <span asp-validation-for="ConsultationFee" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mb-3">
                                <label asp-for="About" class="form-label">About Doctor</label>
                                <textarea asp-for="About" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="About" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="text-muted mb-3">🗓️ Weekly Schedule</h6>
                        <p class="text-muted small">Tick the days you're available and set your hours.</p>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th style="width:80px;">Available</th>
                                        <th>Day</th>
                                        <th>Start</th>
                                        <th>End</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Schedule.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="Schedule[i].Day" />
                                                <input type="checkbox" class="form-check-input"
                                                       asp-for="Schedule[i].IsEnabled" id="sched_@i" />
                                            </td>
                                            <td>
                                                <label for="sched_@i" class="form-check-label fw-semibold">
                                                    @Model.Schedule[i].Day
                                                </label>
                                            </td>
                                            <td>
                                                <input type="time" class="form-control form-control-sm"
                                                       asp-for="Schedule[i].StartTime" />
                                            </td>
                                            <td>
                                                <input type="time" class="form-control form-control-sm"
                                                       asp-for="Schedule[i].EndTime" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 mt-3">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body p-4">
                    <div class="doctor-avatar-preview mx-auto mb-3">
                        @if (!string.IsNullOrEmpty(Model.ExistingProfilePicture))
                        {
                            <img src="@Model.ExistingProfilePicture" alt="Profile picture" />
                        }
                        else
                        {
                            <img src="/img/default-doctor.png" alt="Default avatar" />
                        }
                    </div>
                    <h5 class="fw-bold">@Model.FullName</h5>
                    <p class="text-primary mb-2">@Model.Specialization</p>
                    <p class="text-muted">@Model.Qualification</p>
                    <span class="badge bg-success">Active</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const input = document.getElementById('pictureInput');
            const preview = document.getElementById('avatarPreview');
            if (!input || !preview) return;

            input.addEventListener('change', function () {
                const file = input.files && input.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = e => preview.src = e.target.result;
                reader.readAsDataURL(file);
            });
        })();
    </script>

    <style>
        .doctor-avatar-preview {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid #e5e7eb;
        }
        .doctor-avatar-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }
    </style>
}