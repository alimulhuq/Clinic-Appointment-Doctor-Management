@model ClinicManagementSystem.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Patient Details";
}

<div class="container py-4">

    <a asp-action="Appointments" class="btn btn-outline-secondary btn-sm mb-3">← Back</a>

    <div class="card">
        <div class="card-header bg-primary text-white">
            @Model.PatientName (@Model.PatientCode)
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3">Age</dt>
                <dd class="col-sm-9">@Model.Age</dd>

                <dt class="col-sm-3">Gender</dt>
                <dd class="col-sm-9">@Model.Gender</dd>

                <dt class="col-sm-3">Known Allergies</dt>
                <dd class="col-sm-9">@Model.Allergies</dd>

                <dt class="col-sm-3">Appointment Date</dt>
                <dd class="col-sm-9">@Model.AppointmentDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-3">Appointment Time</dt>
                <dd class="col-sm-9">@Model.AppointmentTime</dd>

                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9">@Model.Reason</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>
        </div>
    </div>

</div>