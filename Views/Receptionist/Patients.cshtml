@model List<ClinicManagementSystem.ViewModels.PatientListItemViewModel>

@{
    ViewData["Title"] = "Patient List";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    <h3 class="mb-4">Patient List</h3>

    <form method="get" asp-action="Patients" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or patient ID" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
    </form>

    <a asp-action="AddPatient" class="btn btn-success mb-3">+ Add Patient</a>

    <div class="card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Patient ID</th>
                    <th>Phone</th>
                    <th>Age</th>
                    <th>Gender</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted">No patients found.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.FullName</td>
                        <td>@p.PatientCode</td>
                        <td>@p.Phone</td>
                        <td>@p.Age</td>
                        <td>@p.Gender</td>
                        <td>
                            <a asp-action="EditPatient" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>