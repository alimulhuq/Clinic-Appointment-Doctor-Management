@model ClinicManagementSystem.ViewModels.ReceptionistBookingViewModel

@{
    ViewData["Title"] = "Book Appointment";
    var patients = ViewBag.Patients as List<ClinicManagementSystem.ViewModels.PatientListItemViewModel>;
    var doctors = ViewBag.Doctors as List<Clinic_Application_Doctor_Management.Models.Doctor>;
}

<div class="container py-4">
    <h3 class="mb-4">Book Appointment</h3>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card">
        <div class="card-body">
            <form asp-action="BookAppointment" method="post" id="bookingForm">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label class="form-label">Patient</label>
                    <select asp-for="PatientId" class="form-select">
                        <option value="">-- Select Patient --</option>
                        @foreach (var p in patients ?? new List<ClinicManagementSystem.ViewModels.PatientListItemViewModel>())
                        {
                            <option value="@p.Id">@p.FullName (@p.PatientCode)</option>
                        }
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Doctor</label>
                    <select asp-for="DoctorId" class="form-select">
                        <option value="">-- Select Doctor --</option>
                        @foreach (var d in doctors ?? new List<Clinic_Application_Doctor_Management.Models.Doctor>())
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger"></span>
                </div>

                <!-- Optional: preview of selected doctor's avatar -->
                <div id="doctorPreview" class="d-none align-items-center gap-3 mb-3 p-3 bg-light rounded">
                    <div class="doctor-mini-avatar" id="doctorPreviewAvatar">
                        <img src="/img/default-doctor.png" alt="Doctor" />
                    </div>
                    <div>
                        <div class="fw-semibold" id="doctorPreviewName"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Appointment Date</label>
                    <input asp-for="AppointmentDate" type="text" class="form-control datepicker-booking"
                           id="appointmentDate" placeholder="Select appointment date" autocomplete="off" />
                    <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    <div id="dateError" class="text-danger small mt-1" style="display:none;"></div>
                    <div class="form-text">Weekends are not available. Earliest booking is today.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Appointment Time</label>
                    <select asp-for="AppointmentTime" class="form-select" id="appointmentTime">
                        <option value="">-- Select Time --</option>
                        <option value="10:00">10:00 AM</option>
                        <option value="10:30">10:30 AM</option>
                        <option value="11:00">11:00 AM</option>
                        <option value="11:30">11:30 AM</option>
                        <option value="16:00">04:00 PM</option>
                        <option value="16:30">04:30 PM</option>
                        <option value="17:00">05:00 PM</option>
                        <option value="17:30">05:30 PM</option>
                    </select>
                    <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Reason</label>
                    <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Book Appointment</button>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const dateInput = document.getElementById('appointmentDate');
            const timeSelect = document.getElementById('appointmentTime');
            const errorDiv = document.getElementById('dateError');
            const form = document.getElementById('bookingForm');

            function validateDateTime() {
                const raw = dateInput.value;
                if (!raw) { clearError(); return true; }
                const selectedDate = new Date(raw + 'T00:00:00');
                const now = new Date();
                const day = selectedDate.getDay();
                if (day === 0 || day === 6) { showError('Appointments are not available on weekends.'); return false; }
                const today = new Date(); today.setHours(0, 0, 0, 0);
                if (selectedDate < today) { showError('Please select a future date.'); return false; }
                if (selectedDate.getTime() === today.getTime() && timeSelect.value) {
                    const parts = timeSelect.value.split(':');
                    const h = parseInt(parts[0]); const m = parseInt(parts[1]);
                    const selectedTime = new Date(); selectedTime.setHours(h, m, 0, 0);
                    if (selectedTime < now) { showError('Please select a future time for today\'s appointment.'); return false; }
                }
                clearError(); return true;
            }
            function showError(message) {
                errorDiv.textContent = message; errorDiv.style.display = 'block';
                dateInput.classList.add('is-invalid');
            }
            function clearError() {
                errorDiv.textContent = ''; errorDiv.style.display = 'none';
                dateInput.classList.remove('is-invalid');
            }
            dateInput.addEventListener('change', validateDateTime);
            timeSelect.addEventListener('change', validateDateTime);
            form.addEventListener('submit', function (e) { if (!validateDateTime()) e.preventDefault(); });

            // Live doctor avatar preview (uses JSON payload embedded by the controller)
            const doctorsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                (doctors ?? new List<Clinic_Application_Doctor_Management.Models.Doctor>())
                    .Select(d => new { id = d.Id, name = d.Name, pic = d.ProfilePicture ?? "" })
                    .ToList()));
            const doctorSelect = document.querySelector('select[name="DoctorId"]');
            const previewWrap = document.getElementById('doctorPreview');
            const previewImg = document.querySelector('#doctorPreviewAvatar img');
            const previewName = document.getElementById('doctorPreviewName');
            if (doctorSelect) {
                doctorSelect.addEventListener('change', function () {
                    const id = parseInt(doctorSelect.value);
                    const found = doctorsData.find(x => x.id === id);
                    if (!found) { previewWrap.classList.add('d-none'); previewWrap.classList.remove('d-flex'); return; }
                    previewImg.src = found.pic && found.pic.length > 0 ? found.pic : '/img/default-doctor.png';
                    previewName.textContent = found.name;
                    previewWrap.classList.remove('d-none');
                    previewWrap.classList.add('d-flex');
                });
            }
        })();
    </script>
    <style>
        #appointmentDate.is-invalid { border-color: #dc3545; background-color: #f8d7da; }
        .doctor-mini-avatar {
            width: 56px; height: 56px; border-radius: 50%;
            overflow: hidden; border: 2px solid #e5e7eb;
            background: #eef2ff; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }
        .doctor-mini-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
    </style>
}