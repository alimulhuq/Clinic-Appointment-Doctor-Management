@model ClinicManagementSystem.ViewModels.ReceptionistDashboardViewModel

@{
    ViewData["Title"] = "Receptionist Dashboard";
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    <h2 class="fw-bold mb-4">Receptionist Dashboard</h2>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Today's Appointments</h6>
                <h3 class="fw-bold">@Model.TodaysAppointments</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Total Patients</h6>
                <h3 class="fw-bold">@Model.TotalPatients</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center p-3">
                <h6 class="text-muted">Pending Confirmations</h6>
                <h3 class="fw-bold">@Model.PendingConfirmations</h3>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-primary text-white">Quick Actions</div>
        <div class="card-body d-flex gap-2">
            <a asp-controller="Receptionist" asp-action="Patients" class="btn btn-outline-primary w-100">Patient List</a>
            <a asp-controller="Receptionist" asp-action="BookAppointment" class="btn btn-outline-primary w-100">Book Appointment</a>
            <a asp-controller="Receptionist" asp-action="Appointments" class="btn btn-outline-primary w-100">Appointments</a>
        </div>
    </div>

</div>