@model List<ClinicManagementSystem.ViewModels.ReceptionistBookingViewModel>

@{
    ViewData["Title"] = "Appointments";
    var bills = ViewBag.Bills as Dictionary<int, Clinic_Application_Doctor_Management.Models.Bill>
                ?? new Dictionary<int, Clinic_Application_Doctor_Management.Models.Bill>();
    var doctors = ViewBag.DoctorsDict as Dictionary<int, Clinic_Application_Doctor_Management.Models.Doctor>
                  ?? new Dictionary<int, Clinic_Application_Doctor_Management.Models.Doctor>();
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning">@TempData["WarningMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Appointments</h3>
        <a asp-action="BookAppointment" class="btn btn-success">+ Book Appointment</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Reason</th>
                        <th>Appointment</th>
                        <th>Payment</th>
                        <th>Balance</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">No appointments booked yet.</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        bills.TryGetValue(a.Id, out var bill);
                        doctors.TryGetValue(a.DoctorId, out var doc);
                        <tr>
                            <td>@a.PatientName</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="doctor-row-avatar">
                                        @if (!string.IsNullOrEmpty(doc?.ProfilePicture))
                                        {
                                            <img src="@doc.ProfilePicture" alt="@a.DoctorName" />
                                        }
                                        else
                                        {
                                            <img src="/img/default-doctor.png" alt="@a.DoctorName" />
                                        }
                                    </div>
                                    <span>@a.DoctorName</span>
                                </div>
                            </td>
                            <td>@a.AppointmentDate.ToString("dd MMM yyyy")</td>
                            <td>@a.AppointmentTime</td>
                            <td>@a.Reason</td>
                            <td>
                                @if (a.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (a.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else if (a.Status == "Completed")
                                {
                                    <span class="badge bg-primary">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (bill == null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (bill.Status == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (bill.Status == "Partial")
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                    <i class="bi bi-exclamation-triangle text-warning" title="Not fully paid"></i>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Unpaid</span>
                                }
                            </td>
                            <td>
                                @if (bill == null)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else if (bill.Balance <= 0)
                                {
                                    <span class="text-success">—</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">@bill.Balance.ToString("0.00")৳</span>
                                }
                            </td>
                            <td>
                                @if (bill != null && bill.Status != "Paid")
                                {
                                    <a asp-action="Checkout" asp-route-appointmentId="@a.Id"
                                       class="btn btn-sm btn-primary">Collect Payment</a>
                                }
                                else if (a.Status == "Pending")
                                {
                                    <form asp-action="ConfirmAppointment" asp-route-id="@a.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                                    </form>
                                    <form asp-action="CancelAppointment" asp-route-id="@a.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .doctor-row-avatar {
        width: 36px; height: 36px; border-radius: 50%;
        overflow: hidden; border: 2px solid #e5e7eb;
        background: #eef2ff; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
    }
    .doctor-row-avatar img {
        width: 100%; height: 100%; object-fit: cover; display: block;
    }
</style>