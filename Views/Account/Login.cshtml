@model ClinicManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card-body">
            <div class="auth-header text-center">
                <div class="auth-logo">
                    <i class="bi bi-hospital"></i>
                </div>
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Sign in to your ClinicCare account</p>
            </div>

            @if (ViewBag.InfoMessage != null)
            {
                <div class="alert alert-info border-0 shadow-sm">@ViewBag.InfoMessage</div>
            }
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Login" asp-controller="Account" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" class="auth-form">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label auth-label">Email Address</label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="you@example.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label auth-label">Password</label>
                    <input asp-for="Password" class="form-control auth-input" placeholder="Enter your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn-primary w-100">Sign In</button>
            </form>

            <div class="auth-footer text-center">
                <p class="mb-2">
                    <span class="text-muted">Don't have an account?</span>
                    <a asp-controller="Account" asp-action="Register" class="auth-link">Create Patient Account</a>
                </p>
                <a asp-controller="Account" asp-action="AdminLogin" class="auth-link-muted">Admin Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}