@model ClinicManagementSystem.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Admin Login";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card-body">
            <div class="auth-header text-center">
                <div class="auth-logo auth-logo-admin">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1 class="auth-title">Admin Login</h1>
                <p class="auth-subtitle">Restricted access for system administrators</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="AdminLogin" asp-controller="Account" method="post" class="auth-form">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label auth-label">Email Address</label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="admin@cliniccare.com" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label auth-label">Password</label>
                    <input asp-for="Password" class="form-control auth-input" placeholder="Enter your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn auth-btn-primary w-100">Sign In as Admin</button>
            </form>

            <div class="auth-footer text-center">
                <a asp-controller="Account" asp-action="Login" class="auth-link">
                    <i class="bi bi-arrow-left me-1"></i> Back to User Login
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}