<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Clinic Management System</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons (admin sidebar) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Our CSS -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/ClinicManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
@{
    var isAdmin = User.Identity?.IsAuthenticated == true
        && User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value == "Admin";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

@if (isAdmin)
{
    <!-- ========== ALL ADMIN PAGES: SIDEBAR LAYOUT ========== -->
    <div class="admin-layout">
        <nav id="adminSidebar" class="admin-sidebar d-flex flex-column">
            <div class="sidebar-brand">
                <span class="brand-icon"></span>
                <span class="brand-text">ClinicCare</span>
            </div>

            <ul class="nav flex-column sidebar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Dashboard" ? "active" : "")"
                       asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Patients" || currentAction == "PatientDetails" ? "active" : "")"
                       asp-controller="Admin" asp-action="Patients">
                        <i class="bi bi-people"></i>
                        <span>Patients</span>
                    </a>
                </li>
               <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Appointments" || currentAction == "AppointmentDetails" ? "active" : "")"
                       asp-controller="Admin" asp-action="Appointments">
                        <i class="bi bi-calendar-check"></i>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "AddDoctor" ? "active" : "")"
                       asp-controller="Admin" asp-action="AddDoctor">
                        <i class="bi bi-person-badge"></i>
                        <span>Add Doctor</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "AddReceptionist" ? "active" : "")"
                       asp-controller="Admin" asp-action="AddReceptionist">
                        <i class="bi bi-person-plus"></i>
                        <span>Add Receptionist</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Profile" ? "active" : "")"
                       asp-controller="Admin" asp-action="Profile">
                        <i class="bi bi-person"></i>
                        <span>Profile</span>
                    </a>
                </li>
            </ul>

            <ul class="nav flex-column sidebar-nav sidebar-bottom">
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "ChangePassword" ? "active" : "")"
                       asp-controller="Admin" asp-action="ChangePassword">
                        <i class="bi bi-gear"></i>
                        <span>Settings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Log Out</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="admin-content">
            <main>
                @RenderBody()
            </main>

            <footer class="admin-footer mt-auto">
                <div class="admin-footer-inner">
                    <span class="admin-footer-brand">ClinicCare</span>
                    <span class="admin-footer-copy">&copy; 2026 ClinicCare. All Rights Reserved.</span>
                    <div class="admin-footer-links">
                        <a asp-controller="Home" asp-action="Doctors">Doctors</a>
                        <a href="#">About</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <!-- ========== NON-ADMIN: ORIGINAL TOP NAVBAR (unchanged) ========== -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">ClinicCare</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Doctors">Doctors</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">About</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;

                            string dashboardController = "";
                            switch (userRole)
                            {
                                case "Doctor":
                                    dashboardController = "Doctor";
                                    break;
                                case "Receptionist":
                                    dashboardController = "Receptionist";
                                    break;
                                default:
                                    dashboardController = "Patient";
                                    break;
                            }
                            <li class="nav-item">
                                <a class="btn btn-outline-light ms-2" asp-controller="@dashboardController" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="MyProfile">My Profile</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary px-4" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary px-4" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h5>ClinicCare</h5>
                    <p class="text-light">
                        Simple and reliable clinic management
                        for patients, doctors and staff.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1">Quick Links</p>
                    <a asp-controller="Home" asp-action="Doctors" class="text-light me-3">Doctors</a>
                    <a href="#" class="text-light">About</a>
                </div>
            </div>
            <hr />
            <div class="text-center">
                <small>&copy; 2026 ClinicCare. All Rights Reserved.</small>
            </div>
        </div>
    </footer>
}

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
