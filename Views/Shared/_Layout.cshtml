<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Clinic Management System</title>

    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" />

    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/ClinicManagementSystem.styles.css" asp-append-version="true" />

    <style>
        /* =========================================
           Flatpickr contrast fixes
           ========================================= */
        .flatpickr-calendar {
            background: #ffffff !important;
            border: 1px solid #d1d5db !important;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
            color: #111827 !important;
        }

        .flatpickr-calendar .flatpickr-months {
            background: #4f46e5 !important;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
        }

        .flatpickr-calendar .flatpickr-month,
        .flatpickr-calendar .flatpickr-current-month,
        .flatpickr-calendar .flatpickr-current-month .cur-month,
        .flatpickr-calendar .flatpickr-current-month input.cur-year {
            color: #ffffff !important;
            fill: #ffffff !important;
            font-weight: 600 !important;
        }

        .flatpickr-calendar .flatpickr-prev-month,
        .flatpickr-calendar .flatpickr-next-month {
            color: #ffffff !important;
            fill: #ffffff !important;
        }

        .flatpickr-calendar .flatpickr-prev-month:hover svg,
        .flatpickr-calendar .flatpickr-next-month:hover svg {
            fill: #fbbf24 !important;
        }

        .flatpickr-calendar .flatpickr-weekdays {
            background: #eef2ff !important;
        }

        .flatpickr-calendar .flatpickr-weekday {
            color: #3730a3 !important;
            font-weight: 700 !important;
            font-size: 0.8rem !important;
        }

        .flatpickr-calendar .flatpickr-days,
        .flatpickr-calendar .dayContainer {
            background: #ffffff !important;
        }

        .flatpickr-calendar .flatpickr-day {
            color: #111827 !important;
            font-weight: 500 !important;
            border-radius: 6px !important;
        }

        .flatpickr-calendar .flatpickr-day.prevMonthDay,
        .flatpickr-calendar .flatpickr-day.nextMonthDay {
            color: #9ca3af !important;
        }

        .flatpickr-calendar .flatpickr-day:hover,
        .flatpickr-calendar .flatpickr-day:focus {
            background: #e0e7ff !important;
            border-color: #c7d2fe !important;
            color: #1e1b4b !important;
        }

        .flatpickr-calendar .flatpickr-day.selected,
        .flatpickr-calendar .flatpickr-day.startRange,
        .flatpickr-calendar .flatpickr-day.endRange,
        .flatpickr-calendar .flatpickr-day.selected.inRange,
        .flatpickr-calendar .flatpickr-day.selected:focus,
        .flatpickr-calendar .flatpickr-day.selected:hover {
            background: #4f46e5 !important;
            border-color: #4f46e5 !important;
            color: #ffffff !important;
            font-weight: 700 !important;
        }

        .flatpickr-calendar .flatpickr-day.today {
            border-color: #4f46e5 !important;
            color: #4f46e5 !important;
            font-weight: 700 !important;
        }

        .flatpickr-calendar .flatpickr-day.today:hover {
            background: #4f46e5 !important;
            color: #ffffff !important;
        }

        .flatpickr-calendar .flatpickr-day.flatpickr-disabled,
        .flatpickr-calendar .flatpickr-day.flatpickr-disabled:hover {
            color: #d1d5db !important;
            background: #f9fafb !important;
            cursor: not-allowed !important;
            text-decoration: line-through;
        }

        .flatpickr-calendar .flatpickr-months .flatpickr-month .flatpickr-current-month .flatpickr-monthDropdown-months {
            background: transparent !important;
            color: #ffffff !important;
        }

        .flatpickr-calendar .flatpickr-months .flatpickr-month .flatpickr-current-month .flatpickr-monthDropdown-months option {
            background: #ffffff !important;
            color: #111827 !important;
        }

        .flatpickr-input[readonly] {
            background-color: #fff !important;
            cursor: pointer !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
@{
    var role = User.Identity?.IsAuthenticated == true
        ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        : null;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isAdmin = role == "Admin"
        && string.Equals(currentController, "Admin", StringComparison.OrdinalIgnoreCase);
}

@if (isAdmin)
{
    <div class="admin-layout">
        <nav id="adminSidebar" class="admin-sidebar d-flex flex-column">
            <div class="sidebar-brand">
                <span class="brand-icon"></span>
                <span class="brand-text">ClinicCare</span>
            </div>

            <ul class="nav flex-column sidebar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Dashboard" ? "active" : "")"
                       asp-controller="Admin" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Patients" || currentAction == "PatientDetails" ? "active" : "")"
                       asp-controller="Admin" asp-action="Patients">
                        <i class="bi bi-people"></i>
                        <span>Patients</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Appointments" || currentAction == "AppointmentDetails" ? "active" : "")"
                       asp-controller="Admin" asp-action="Appointments">
                        <i class="bi bi-calendar-check"></i>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Doctors" || currentAction == "AddDoctor" || currentAction == "DoctorDetails" || currentAction == "EditDoctor" || currentAction == "DeleteDoctor" ? "active" : "")"
                       asp-controller="Admin" asp-action="Doctors">
                        <i class="bi bi-person-badge"></i>
                        <span>Doctors</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Receptionists" || currentAction == "AddReceptionist" || currentAction == "ReceptionistDetails" || currentAction == "EditReceptionist" || currentAction == "DeleteReceptionist" ? "active" : "")"
                       asp-controller="Admin" asp-action="Receptionists">
                        <i class="bi bi-person-plus"></i>
                        <span>Receptionists</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "Profile" ? "active" : "")"
                       asp-controller="Admin" asp-action="Profile">
                        <i class="bi bi-person"></i>
                        <span>Profile</span>
                    </a>
                </li>
            </ul>

            <ul class="nav flex-column sidebar-nav sidebar-bottom">
                <li class="nav-item">
                    <a class="nav-link admin-nav-link @(currentAction == "ChangePassword" ? "active" : "")"
                       asp-controller="Admin" asp-action="ChangePassword">
                        <i class="bi bi-gear"></i>
                        <span>Settings</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link admin-nav-link" asp-controller="Account" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Log Out</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="admin-content">
            <main>
                @RenderBody()
            </main>

            <footer class="admin-footer mt-auto">
                <div class="admin-footer-inner">
                    <span class="admin-footer-brand">ClinicCare</span>
                    <span class="admin-footer-copy">&copy; 2026 ClinicCare. All Rights Reserved.</span>
                    <div class="admin-footer-links">
                        <a asp-controller="Home" asp-action="Doctors">Doctors</a>
                        <a href="#">About</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">ClinicCare</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <!-- Guests only -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Doctors">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">About</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary px-4" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                        }
                        else if (role == "Patient")
                        {
                            <!-- Patient: full public nav -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Doctors">Doctors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="#">About</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light ms-2" asp-controller="Patient" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="MyProfile">My Profile</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary px-4" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                        else
                        {
                            <!-- Doctor / Receptionist / Admin: no Home / About -->
                            string dashboardController = "";
                            switch (role)
                            {
                                case "Doctor": dashboardController = "Doctor"; break;
                                case "Receptionist": dashboardController = "Receptionist"; break;
                                case "Admin": dashboardController = "Admin"; break;
                                default: dashboardController = "Patient"; break;
                            }
                            <li class="nav-item">
                                <a class="btn btn-outline-light ms-2" asp-controller="@dashboardController" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="MyProfile">My Profile</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light text-primary px-4" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h5>ClinicCare</h5>
                    <p class="text-light">
                        Simple and reliable clinic management
                        for patients, doctors and staff.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-1">Quick Links</p>
                    <a asp-controller="Home" asp-action="Doctors" class="text-light me-3">Doctors</a>
                    <a href="#" class="text-light">About</a>
                </div>
            </div>
            <hr />
            <div class="text-center">
                <small>&copy; 2026 ClinicCare. All Rights Reserved.</small>
            </div>
        </div>
    </footer>
}

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>

    <!-- Global date picker init -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof flatpickr === 'undefined') return;

            // Birth date picker — no future dates
            document.querySelectorAll('input.datepicker-dob').forEach(function (el) {
                flatpickr(el, {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d M Y",
                    maxDate: "today",
                    minDate: "1900-01-01",
                    defaultDate: el.value || null,
                    allowInput: true,
                    disableMobile: true,
                    monthSelectorType: 'static'
                });
            });

            // Booking date picker — no past dates, no weekends
            document.querySelectorAll('input.datepicker-booking').forEach(function (el) {
                flatpickr(el, {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d M Y",
                    minDate: "today",
                    defaultDate: el.value || null,
                    allowInput: true,
                    disableMobile: true,
                    monthSelectorType: 'static',
                    disable: [
                        function (date) {
                            return date.getDay() === 0 || date.getDay() === 6;
                        }
                    ]
                });
            });
        });
    </script>

    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>